# GuardRail configuration (Twelve-Factor). Copy to .env and fill in secrets.
# The application FAILS TO START if required secrets are missing or too weak.
# Generate strong values, e.g.:  openssl rand -base64 48

# ---- Runtime ----
GUARDRAIL_ENV=development           # development | staging | production

# ---- Images ----
# VERSION is the image tag pulled from the registry AND the version the API
# reports. Pin it to a release (e.g. 1.1.2) on a server: "latest" makes the next
# `compose pull` a surprise upgrade of a system people are logged into.
# `docker compose build` ignores the registry and builds from this checkout.
VERSION=1.1.2
# Override only to publish or consume from a different namespace (a fork, or an
# internal mirror on an air-gapped network).
#GUARDRAIL_IMAGE_API=ghcr.io/ansh-gadhia/guardrail-api
#GUARDRAIL_IMAGE_WEB=ghcr.io/ansh-gadhia/guardrail-web

# ---- Published ports (docker compose) ----
# What the server listens on for the network. Change these here, not in
# docker-compose.yml. HTTPS is the console, the API and brokered sessions, all on
# one port; HTTP only redirects to it.
GUARDRAIL_HTTPS_PORT=443
GUARDRAIL_HTTP_PORT=80

# Where Postgres and Redis are published on the server. 127.0.0.1 keeps them
# reachable for psql and backups but off the network entirely.
# WARNING: setting either BIND_ADDR to 0.0.0.0 exposes the datastore to the LAN.
# The credential vault and every audit record live in Postgres; leave it on
# loopback unless you have a specific reason and a firewall in front of it.
POSTGRES_BIND_ADDR=127.0.0.1
POSTGRES_PORT=5432
REDIS_BIND_ADDR=127.0.0.1
REDIS_PORT=6379

# ---- HTTP ----
# Whose X-Forwarded-For the API believes. This decides the client IP in every
# audit record, so it is a real security setting, not plumbing: trust the wrong
# thing and anyone can forge who they were.
#
# 0.0.0.0/0 is safe *here specifically* because the API's port is never published
# — only Traefik, on the internal Docker network, can reach it at all. If you
# expose the API directly, narrow this to your proxy's CIDR.
GUARDRAIL_TRUST_PROXY_HEADERS=true
GUARDRAIL_TRUSTED_PROXIES=0.0.0.0/0

# Only needed if the console is served from a different origin than the API.
# Under compose they share one origin, so this stays empty. Production refuses
# the "*" wildcard outright.
GUARDRAIL_CORS_ALLOW_ORIGINS=

# ---- Whole-host session delivery (the tunnel) ----
# Base domain for per-session hostnames: a proxied device is served at
# https://<session-id>.<this-domain>/, i.e. at the ROOT of its own origin.
#
# Why it exists: served under a path prefix (/proxy/<sid>/), a device UI written
# for "/" has to have every root-absolute URL rewritten, and window.location
# cannot be intercepted by any shim — so an appliance SPA that hard-navigates
# escapes the prefix and lands on the GuardRail console. Its own hostname has no
# prefix to escape.
#
# Requirements when enabled (both handled by `make install` on this host):
#   - wildcard DNS: *.<this-domain> -> this server's LAN IP. The bundled `dns`
#     compose profile answers it; otherwise add one record on your resolver.
#   - a TLS cert naming *.<this-domain>. bootstrap.sh puts it in the self-signed
#     cert it generates.
#
# Set it EMPTY to disable the tunnel; sessions then serve under /proxy/<sid>/
# exactly as they did before this existed. Never put an IP here — the server's
# address is auto-detected and is not part of this name.
GUARDRAIL_TUNNEL_DOMAIN=tunnel.guardrail.lan

# ---- Secrets (REQUIRED, >= 32 bytes each) ----
GUARDRAIL_JWT_SIGNING_KEY=CHANGE_ME_generate_a_48_byte_base64_secret_here
# Master key (KEK) for the credential vault's envelope encryption.
GUARDRAIL_MASTER_KEY=CHANGE_ME_generate_a_48_byte_base64_secret_here

# ---- PostgreSQL ----
POSTGRES_USER=guardrail
POSTGRES_PASSWORD=CHANGE_ME_postgres_superuser_password
POSTGRES_DB=guardrail
# Password for the least-privilege application login role (used by the API so
# Row-Level Security is enforced; the superuser above is only for migrations).
GUARDRAIL_DB_APP_PASSWORD=CHANGE_ME_app_role_password
# The API builds its own DSN from the values above and the guardrail_app role.
# See the bare-metal section at the bottom if you run the API outside compose.

# TLS between the API and the database. install.sh SETS BOTH OF THESE — issuing
# the certificate and then turning them on — so they are here to be read, not to
# be filled in by hand.
#
# They default to off so that an update which replaces docker-compose.yml while
# the OLD install.sh is still running brings the stack up exactly as it was,
# rather than demanding a certificate that script never generated. TLS switches
# on at the next update, once the certificate exists.
#
# GUARDRAIL_PG_SSLPARAMS is the whole client query string in one variable, not a
# mode and a path separately, because pgx opens sslrootcert even when
# sslmode=disable — so the two must never be able to disagree.
#
#   GUARDRAIL_PG_SSL=on
#   GUARDRAIL_PG_SSLPARAMS=sslmode=verify-full&sslrootcert=/etc/guardrail/pgtls/server.crt
#   GUARDRAIL_PG_HBA=/etc/postgresql/hba/pg_hba.conf
#
# GUARDRAIL_PG_HBA is the one that makes TLS mandatory rather than merely
# available: ssl=on only OFFERS encryption, and a client asking for
# sslmode=disable is still served plaintext. deploy/postgres/hba/pg_hba.conf is
# the image's own file with its catch-all changed from `host` to `hostssl`, so a
# connection that declines TLS matches no rule and is refused. The default below
# is the image's file, which does not require it.
#
# The local socket stays `trust` in both, so the healthcheck, `docker compose
# exec postgres psql` and the documented pg_dump backup keep working.
#
# THE THREE MOVE TOGETHER. install.sh always writes them as a set. Editing one by
# hand is how you get a database nobody can reach: GUARDRAIL_PG_HBA demanding TLS
# while GUARDRAIL_PG_SSL=off means every network client matches no rule at all.
GUARDRAIL_PG_SSL=off
GUARDRAIL_PG_SSLPARAMS=sslmode=disable
GUARDRAIL_PG_HBA=/var/lib/postgresql/data/pg_hba.conf

# ---- Redis ----
# install.sh generates this. Empty means Redis runs with NO AUTHENTICATION, which
# is how this shipped and should not be left that way: the login throttle, the
# SSO replay nonces and the live session registry all live in Redis, so anything
# that can reach the port can clear a lockout, replay a sign-in, or read who is
# connected to what. The loopback bind is a second line of defence, not a
# substitute for this one.
REDIS_PASSWORD=

# ---- Primary super admin (bootstrapped from the environment on first boot) ----
# Set/change these BEFORE the first start. On first boot GuardRail creates this
# super admin automatically (idempotent — a no-op on later boots). Leave both
# EMAIL and PASSWORD empty to bootstrap manually with `guardrail seed-admin`.
# The process REFUSES TO START if the password is set but shorter than 12 chars.
# After first boot, rotate it from the console: Account -> Password.
GUARDRAIL_ADMIN_EMAIL=admin@yourco.com
GUARDRAIL_ADMIN_PASSWORD=CHANGE_ME_min_12_chars_before_first_boot
GUARDRAIL_ADMIN_USERNAME=admin
GUARDRAIL_ADMIN_ORG=default

# ---- Session recording ----
# Recording needs browser isolation: the reverse proxy hands the device's own
# HTML to your browser and never sees pixels, so there is nothing to record.
# With this off, a device with recording switched on quietly gets a plain proxy
# session instead — the policy reads as "on" while recording nothing.
GUARDRAIL_BROWSER_ISOLATION=true
# Which Chromium to launch. Blank autodetects chromium / chromium-browser /
# google-chrome from $PATH, which is right under compose (the image installs
# Chromium at /usr/bin/chromium). Set it when the browser is not on $PATH — e.g.
# running the API natively against a Playwright/Puppeteer cached Chromium. If it
# cannot be resolved, the server says so at startup and reports session recording
# as unavailable rather than failing at connect time.
GUARDRAIL_CHROME_PATH=
# Frames are written here, inside the container. Under compose this is the
# `recordings` volume; back it up alongside the database, since it is evidence.
GUARDRAIL_RECORDING_DIR=/var/lib/guardrail/recordings

# How long session recordings are kept, in days. 0 keeps them indefinitely.
#
# This seeds an organization that has never set a policy. It is not the live
# value: retention is an administrator's decision, so it is stored per tenant in
# the database and changed in the console (Settings) without a redeploy. Editing
# it here changes what a NEW organization inherits and what the console shows as
# "this deployment's configured default" — it does not overwrite a policy
# somebody already set, because a restart silently undoing an administrator's
# change would be worse than the two values differing visibly.
#
# The console shows both, so a divergence is something you can see rather than
# something you have to remember. Nothing enforced retention at all before this:
# recordings carried a deadline that no code ever read.
GUARDRAIL_RECORDING_RETENTION_DAYS=90

# ---- Desktop access (RDP / VNC) ----
# RDP and VNC are brokered through guacd, the Apache Guacamole proxy daemon: it
# speaks the desktop protocol to the device and renders it into drawing
# instructions the console paints on a canvas. The device credential goes into
# guacd's connect handshake server-side and never reaches the browser — the same
# guarantee browser isolation gives a web UI.
#
# On by default: RDP is what most Windows estates actually need brokering, and a
# deployment that discovers desktop access is off only when someone tries to
# connect has already wasted the operator's time. With this off, connecting to an
# RDP or VNC device is refused rather than failing at connect time.
#
# This flag and the sidecar are two halves of one decision — turn them off
# together if you broker no desktops:
#   GUARDRAIL_DESKTOP_ENABLED=false   and omit `--profile desktop`
# The installer starts the desktop profile whenever this is true.
GUARDRAIL_DESKTOP_ENABLED=true
# Where guacd listens. Under compose this is the service name on the internal
# network; running the API natively, publish guacd on loopback and use
# 127.0.0.1:4822. Never expose this port to the network: guacd has no
# authentication of its own, so anything that can reach it can ask it to connect
# to any host with any credential.
#GUARDRAIL_GUACD_ADDR=guacd:4822
# TLS on the guacd hop. install.sh SETS BOTH OF THESE, together, after issuing
# guacd's certificate — they are two halves of one connection and either alone is
# a broken hop rather than a weaker one.
#
# It matters because target RDP and VNC passwords travel this connection as guacd
# connection parameters, and guacd authenticates nobody: in the clear, anything on
# the network could both read those passwords and drive guacd into the estate
# outside GuardRail's audit trail. The API pins guacd's certificate as the only
# root, so the hop is authenticated as well as encrypted.
#
# Empty for the same reason the database flags default off — see the PostgreSQL
# section. When they are set they look like this:
#
#   GUARDRAIL_GUACD_TLS_ARGS=-C /etc/guacd/tls/guacd.crt -K /etc/guacd/tls/guacd.key
#   GUARDRAIL_GUACD_TLS_CA=/etc/guardrail/guacdtls/guacd.crt
GUARDRAIL_GUACD_TLS_ARGS=
GUARDRAIL_GUACD_TLS_CA=
# Scratch space shared between guacd and the API: guacd writes each session
# recording here, the API moves it into the blob store when the session ends and
# deletes it. Both must be able to see this path.
#
# guacd (uid 1000) writes recordings here 0640 (group-readable); the API joins
# guacd's group (compose group_add: "1000") to read them back. So the directory is
# owned by guacd and setgid. If you change this path, create it yourself:
#
#   sudo mkdir -p <path>
#   sudo chown 1000:1000 <path> && sudo chmod 2770 <path>
#
# Leave it to Docker and Docker creates the bind-mount source as root:root 755,
# which guacd cannot write to. It does not fail loudly when that happens: it logs
# the error and serves the desktop anyway, so the session works perfectly and
# records nothing. `make install` sets this up for the default path.
#GUARDRAIL_GUACD_RECORDING_DIR=/var/lib/guardrail/desktop-recordings
# The desktop size requested of the device. The console rescales to fit the
# window; this is the resolution the device itself is asked to render.
#GUARDRAIL_DESKTOP_WIDTH=1280
#GUARDRAIL_DESKTOP_HEIGHT=800

# ---- Logging ----
GUARDRAIL_LOG_LEVEL=info            # debug | info | warn | error
GUARDRAIL_LOG_FORMAT=json           # json | console


# ===========================================================================
# OPTIONAL — everything below is off, and the built-in default is what runs.
#
# These are commented out rather than set to their defaults on purpose: an
# assignment here is indistinguishable from a deliberate choice, and a file full
# of restated defaults hides the handful of values that actually matter. Every
# key is already wired through docker-compose.yml, so uncommenting one is enough
# to make it take effect — no compose edit needed.
# ===========================================================================

# ---- Tokens ----
# How long an access token, then a sign-in, stays valid.
#GUARDRAIL_ACCESS_TOKEN_TTL=15m
#
# How long a console sign-in lasts. Closing the browser signs you out: the
# session cookie is discarded on exit, and — because Chrome, Edge and Firefox can
# restore session cookies when set to reopen previous tabs — the server also ends
# any sign-in nothing has kept alive for GUARDRAIL_CONSOLE_IDLE_TIMEOUT. An open
# console refreshes itself, so that limit is only ever reached once it is closed
# or the machine has slept.
#
# GUARDRAIL_REFRESH_TOKEN_TTL is the most any one sign-in may last, however
# actively it is used. It was a SLIDING 720h: every refresh granted another
# thirty days, so opening the console monthly kept somebody signed in forever.
# It is now absolute, counted from sign-in.
#
# The idle timeout must be at least twice the access token TTL, or people who
# are actively working get signed out; 0 switches the idle limit off.
#GUARDRAIL_REFRESH_TOKEN_TTL=12h
#GUARDRAIL_CONSOLE_IDLE_TIMEOUT=30m

# ---- Session length ----
# What ends a session in normal use is neither of these. It is the per-device
# "End session when idle" setting (default 60 minutes), measured from the last
# keystroke or page load, so somebody working is never cut off mid-task.
#
# MAX_SESSION_WINDOW is the ceiling around that: the longest a session with no
# approved window may run however busy it is. It exists so a forgotten tab held
# open by a background poll cannot live forever.
#
# APPROVAL_WINDOW is only a fallback, used when an approved request named no
# duration. An approver who grants thirty minutes gets thirty minutes, and
# activity does not extend it.
#GUARDRAIL_MAX_SESSION_WINDOW=12h
#GUARDRAIL_APPROVAL_WINDOW=1h
#
# The three knobs behind it. The per-device value is edited in the console and is
# the live one; these decide what a new device STARTS with, how often the reaper
# looks, and how often a session in continuous use writes its activity stamp.
#
#   GUARDRAIL_DEFAULT_IDLE_TIMEOUT_MINUTES  what a NEW device inherits. Existing
#       devices keep what they are set to. 0 means new devices never idle out.
#   GUARDRAIL_SESSION_SWEEP_INTERVAL  how often the reaper NOTICES. Not how long
#       a session gets: an expired session's ended_at is backdated to the moment
#       it actually lapsed, so this is the console's catch-up lag, nothing more.
#   GUARDRAIL_ACTIVITY_INTERVAL  at most one activity stamp is written per
#       session per interval. Typing touches a session on every keystroke and
#       persisting each one would be a database write per character.
GUARDRAIL_DEFAULT_IDLE_TIMEOUT_MINUTES=60
GUARDRAIL_SESSION_SWEEP_INTERVAL=30s
GUARDRAIL_ACTIVITY_INTERVAL=30s

# ---- Emergency (break-glass) access ----
# The emergency button connects immediately and is reviewed afterwards. It is
# reachable by anybody the approval gate applies to, deliberately: a door people
# can see beats a wall they climb by sharing the break-glass credential.
#
# This is what stops it replacing the approval workflow. Reachable and unlimited
# are different settings, and only the second one makes asking optional. Sized so
# routine use runs out and genuine use does not — somebody in a real incident
# takes emergency access rarely, somebody avoiding the queue takes it daily.
#
# It counts accesses TAKEN, not attempted: an emergency that never became a
# session gave nobody access and costs nothing.
#
# Setting the quota to 0 removes the limit.
#GUARDRAIL_EMERGENCY_QUOTA=2
#GUARDRAIL_EMERGENCY_QUOTA_WINDOW=168h

# ---- Federation: OIDC / LDAP sign-in ----
# All providers stay disabled unless GUARDRAIL_FEDERATION_ORG_ID names the
# organization federated users are provisioned into. Set it first.
#GUARDRAIL_FEDERATION_ORG_ID=

# OIDC (Authorization Code + PKCE). Active once issuer + client id + redirect
# are all set. The redirect is where the BROWSER is sent back to, so it must be
# the console's public URL — scheme, host and GUARDRAIL_HTTPS_PORT — not the
# internal API port, and your identity provider must allow it exactly.
#GUARDRAIL_OIDC_ISSUER=
#GUARDRAIL_OIDC_CLIENT_ID=
#GUARDRAIL_OIDC_CLIENT_SECRET=
#GUARDRAIL_OIDC_REDIRECT_URL=https://guardrail.yourco.com/api/v1/auth/oidc/callback

# LDAP / Active Directory (search-then-bind). Active once url + base DN are set.
#
# Keep these hints on their own lines. A trailing "# comment" after an EMPTY
# value is not stripped by the compose .env parser — it becomes the value — so
# `GUARDRAIL_LDAP_URL=   # ldap://host:389` would hand the API the literal
# string "# ldap://host:389" and fail in a thoroughly confusing way.
#
# ldap://host:389 or ldaps://host:636
#GUARDRAIL_LDAP_URL=
# Service account DN for the user search.
#GUARDRAIL_LDAP_BIND_DN=
#GUARDRAIL_LDAP_BIND_PASSWORD=
# e.g. ou=people,dc=corp,dc=com
#GUARDRAIL_LDAP_BASE_DN=
# e.g. (uid=%s) or (sAMAccountName=%s)
#GUARDRAIL_LDAP_USER_FILTER=

# ---- Tracing ----
# Empty disables trace export entirely; set an OTLP collector endpoint to turn
# it on. SERVICE_NAME only labels the exported spans.
#GUARDRAIL_OTLP_ENDPOINT=
#GUARDRAIL_SERVICE_NAME=guardrail-api

# ---- Running the API outside compose (bare metal / `make run`) ----
# docker compose sets all four of these itself, from the service names and ports
# on the internal network, and ignores whatever is here — so they are commented
# out to avoid looking like live settings that do nothing. They matter only when
# you run the Go binary directly (DEPLOYMENT.md, "Local development").
#GUARDRAIL_HTTP_ADDR=:8080
#GUARDRAIL_METRICS_ADDR=:9090
#GUARDRAIL_REDIS_ADDR=localhost:6379
# Point this at whatever POSTGRES_PORT you published above.
#GUARDRAIL_POSTGRES_DSN=postgres://guardrail:CHANGE_ME_postgres_superuser_password@localhost:5432/guardrail?sslmode=disable
